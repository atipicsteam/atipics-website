---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RichText from "../../components/RichText.tsx";
import { reader } from "../../lib/keystatic-reader";

export async function getStaticPaths() {
  const articles = await reader.collections.journal.all();
  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const article = await reader.collections.journal.read(slug, { resolveLinkedFiles: true });
const parametres = (await reader.singletons.parametres.read({ resolveLinkedFiles: true })) ?? ({} as any);

if (!article) {
  throw new Error(`Article introuvable : ${slug}`);
}

const pageUrl = Astro.url.href;
const pageTitle = article.title;
const coverUrl = article.cover ? new URL(article.cover, Astro.url).href : '';

const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(pageTitle);
const encodedCover = encodeURIComponent(coverUrl);
---

<Layout title={`${article.title} — ${parametres.nom_site}`} description={article.title}>
  <Header />
  <main style="padding-top: var(--nav-h); min-height: calc(100vh - var(--footer-h) - var(--social-bar-h));">
    
    <article class="article-detail">
      <header class="article-detail__head">
        <div class="container container--narrow">
          <div class="article-detail__meta">
            <span class="article-detail__cat">{article.category}</span>
            <span class="article-detail__sep">—</span>
            <time class="article-detail__date" datetime={article.date}>{article.dateLabel}</time>
          </div>
          <h1 class="article-detail__title">{article.title}</h1>
        </div>
      </header>

      {article.cover && (
        <div class="article-detail__cover container">
          <img src={article.cover} alt={article.title} />
        </div>
      )}

      <div class="container container--narrow">
        <div class="article-detail__content">
          {article.content ? (
            <RichText document={article.content} />
          ) : (
            <p><em>(Le contenu de cet article est en cours de rédaction)</em></p>
          )}
        </div>

        <div class="article-share">
          <span class="article-share__label">Partager</span>
          <a href="https://instagram.com/atipics" target="_blank" rel="noopener" class="article-share__btn" aria-label="Instagram" style="--c:#E1306C"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg></a>
          <a href={`https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodedCover}&description=${encodedTitle}`} target="_blank" rel="noopener" class="article-share__btn" aria-label="Pinterest" style="--c:#E60023"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.19-.77 1.26-5.33 1.26-5.33s-.32-.64-.32-1.59c0-1.49.87-2.6 1.94-2.6.92 0 1.36.69 1.36 1.51 0 .92-.59 2.3-.89 3.58-.25 1.07.53 1.94 1.58 1.94 1.9 0 3.17-2.43 3.17-5.31 0-2.19-1.47-3.85-4.15-3.85-3.03 0-4.91 2.26-4.91 4.79 0 .87.26 1.48.67 1.96.19.22.21.31.14.57-.05.18-.16.63-.2.8-.06.25-.25.34-.47.25-1.32-.54-1.93-2-1.93-3.63 0-2.7 2.28-5.96 6.8-5.96 3.64 0 6.04 2.64 6.04 5.47 0 3.75-2.07 6.56-5.12 6.56-1.02 0-2-.55-2.33-1.18l-.65 2.53c-.23.86-.68 1.72-1.1 2.39.83.25 1.7.39 2.61.39 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg></a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener" class="article-share__btn" aria-label="Facebook" style="--c:#1877F2"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener" class="article-share__btn" aria-label="LinkedIn" style="--c:#0A66C2"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
          <a href="https://atipics.substack.com" target="_blank" rel="noopener" class="article-share__btn" aria-label="Substack" style="--c:#FF6719"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg></a>
          <a href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener" class="article-share__btn" aria-label="WhatsApp" style="--c:#25D366"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>
          <a href="mailto:contact@atipics.fr" class="article-share__btn" aria-label="Email" style="--c:#888884"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></a>
        </div>
      </div>
    </article>

  </main>
  <Footer />
</Layout>

<style>
  .container--narrow {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .article-detail {
    padding-bottom: var(--sp-xl);
  }

  .article-detail__head {
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-lg);
    text-align: center;
  }

  .article-detail__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .article-detail__sep { color: var(--c-border); }

  .article-detail__title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .article-detail__cover {
    margin-bottom: var(--sp-xl);
  }

  .article-detail__cover img {
    width: 100%;
    aspect-ratio: 21/9;
    object-fit: cover;
    background: var(--c-surface);
  }

  .article-detail__content {
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .article-detail__content :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-detail__content :global(h2) {
    font-size: 1.8rem;
    font-weight: 300;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .article-detail__content :global(h3) {
    font-size: 1.4rem;
    font-weight: 400;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-detail__content :global(ul), .article-detail__content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-detail__content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-detail__content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
  }
  
  .article-detail__content :global(blockquote) {
    border-left: 2px solid var(--c-accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-size: 1.2rem;
    font-style: italic;
    color: var(--c-muted);
  }

  .article-share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }
  .article-share__label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-right: 0.5rem;
  }
  .article-share__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--c);
    transition: opacity 0.2s, transform 0.2s;
  }
  .article-share__btn:hover { opacity: 0.7; transform: translateY(-1px); }
</style>
