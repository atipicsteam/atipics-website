---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RichText from "../components/RichText.tsx";
import { reader } from "../lib/keystatic-reader";

const parametres = (await reader.singletons.parametres.read({ resolveLinkedFiles: true })) ?? ({} as any);

// Charger tous les articles générés par Keystatic (résout les champs richDoc externalisés en .mdoc)
const rawArticles = await reader.collections.journal.all({ resolveLinkedFiles: true });
const articles = rawArticles.map((a) => a.entry).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title={`Journal — ${parametres.nom_site}`} description="Actualités, découvertes et réflexions de l'Agence Atipics">
  <Header />
  <main style="padding-top: var(--nav-h); min-height: calc(100vh - var(--footer-h) - var(--social-bar-h));">

    <!-- Header -->
    <section class="page-head">
      <div class="container">
        <div class="label-row">
          <span class="section-stamp">JOURNAL</span>
          <div class="rule"></div>
        </div>
        <h1 class="page-head__title">Actualités &amp; Réflexions</h1>
        <p class="page-head__sub">Nos découvertes, nos coups de cœur, nos chroniques depuis le Village.</p>
      </div>
    </section>

    <!-- Grille articles -->
    <section class="articles">
      <div class="container">
        <div class="articles__grid">
          {articles.map((a) => (
            <article class="art-card">
              <div class="art-card__img-wrap">
                <img src={a.cover} alt={a.title} class="art-card__img" loading="lazy" />
              </div>
              <div class="art-card__body">
                <div class="art-card__meta">
                  <span class="art-card__cat">{a.category}</span>
                  <span class="art-card__sep">—</span>
                  <time class="art-card__date" datetime={a.date}>{a.dateLabel}</time>
                </div>
                <h2 class="art-card__title">{a.title}</h2>
                <RichText document={a.excerpt} className="art-card__excerpt" />

                <span class="art-card__read">Lire →</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ─── Helpers ─── */
  .label-row {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
    margin-bottom: var(--sp-md);
  }
  .section-stamp {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--c-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--c-border);
  }

  /* ─── Page head ─── */
  .page-head {
    padding-top: var(--sp-lg);
    padding-bottom: var(--sp-lg);
    border-bottom: 1px solid var(--c-border);
  }
  .page-head__title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 0.92;
    margin-bottom: var(--sp-sm);
  }
  .page-head__sub {
    font-size: var(--text-xs);
    color: var(--c-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  /* ─── Articles grid ─── */
  .articles {
    padding-block: var(--sp-lg);
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-md) var(--sp-md);
  }

  /* ─── Article card ─── */
  .art-card {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .art-card__img-wrap {
    overflow: hidden;
    aspect-ratio: 16/10;
    background: var(--c-surface);
    margin-bottom: 0.75rem;
  }
  .art-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .art-card:hover .art-card__img { transform: scale(1.04); }

  .art-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .art-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    text-transform: uppercase;
  }
  .art-card__sep { color: var(--c-border); }

  .art-card__title {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .art-card:hover .art-card__title { text-decoration: underline; text-decoration-color: var(--c-border); }

  .art-card__excerpt {
    font-size: var(--text-xs);
    color: var(--c-muted);
    line-height: 1.75;
    margin-top: 0.2rem;
  }

  .art-card__read {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    margin-top: auto;
    padding-top: 0.5rem;
    transition: color 0.2s;
  }
  .art-card:hover .art-card__read { color: var(--c-text); }

  @media (max-width: 900px) {
    .articles__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .articles__grid { grid-template-columns: 1fr; }
  }


</style>

